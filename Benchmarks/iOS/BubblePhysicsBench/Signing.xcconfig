// Ustawienia podpisu hosta benchmarku.
// Wartości osobiste (team ID, bundle identifier) nie mogą trafić do repozytorium.
// Skopiuj Signing.local.xcconfig.example do Signing.local.xcconfig (ignorowany przez git)
// i ustaw tam DEVELOPMENT_TEAM oraz BENCH_BUNDLE_IDENTIFIER.

DEVELOPMENT_TEAM =
BENCH_BUNDLE_IDENTIFIER = com.example.BubblePhysicsBench
CODE_SIGN_STYLE = Automatic

#include? "Signing.local.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(BENCH_BUNDLE_IDENTIFIER)

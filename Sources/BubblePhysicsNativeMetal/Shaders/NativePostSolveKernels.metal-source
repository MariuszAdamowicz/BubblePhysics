// ABI: cztery atomiki uint, wyłącznie liczniki i bity statusu.
// Każdy wątek bańki zapisuje tylko własną pozycję oraz rząd kandydatów.
void nativeSafetyEvent(device atomic_uint *safety, uint slot) {
    atomic_fetch_add_explicit(safety + slot, 1, memory_order_relaxed);
}
void nativeSafetyFailure(device atomic_uint *safety, uint bit) {
    atomic_fetch_or_explicit(safety + 3, bit, memory_order_relaxed);
}

kernel void nativeFindFastCandidates(device NativeBubble *bubbles [[buffer(0)]],
    device NativeSegment *segments [[buffer(1)]], constant NativeControl &control [[buffer(2)]],
    device NativeContactControl &contacts [[buffer(3)]], device uint *candidates [[buffer(4)]],
    device uint *changed [[buffer(5)]], device atomic_uint *safety [[buffer(6)]],
    uint i [[thread_position_in_grid]]) {
    if (i >= control.counts.x) return;
    changed[i] = 0;
    NativeBubble b = bubbles[i];
    float2 movement = b.motion.xy * control.physics.x;
    float2 lower = min(b.position.zw, b.position.xy) - b.physical.z;
    float2 upper = max(b.position.zw, b.position.xy) + b.physical.z;
    for (uint j = 0; j < control.counts.y; ++j) {
        NativeSegment s = segments[j];
        float relative = max(length(movement - (s.current.xy - s.previous.xy)),
                             length(movement - (s.current.zw - s.previous.zw)));
        float2 segmentLower = min(min(s.previous.xy, s.previous.zw), min(s.current.xy, s.current.zw));
        float2 segmentUpper = max(max(s.previous.xy, s.previous.zw), max(s.current.xy, s.current.zw));
        bool fast = relative > contacts.thresholds.y * b.physical.z
            && all(lower <= segmentUpper) && all(upper >= segmentLower);
        candidates[i * control.counts.y + j] = fast ? 1 : 0;
        if (fast) nativeSafetyEvent(safety, 0);
    }
}

float2 nativeReturnToOriginalSide(float2 start, float2 end, NativeSegment s, float margin) {
    float2 normal = nativeSegmentNormal(s.current);
    float side = dot(start - s.previous.xy, nativeSegmentNormal(s.previous));
    float sign = s.flags.z ? s.collision.x : (side < 0 ? -1.0f : 1.0f);
    float distance = dot(end - s.current.xy, normal);
    if (distance * sign < margin) end += normal * (sign * margin - distance);
    return end;
}

bool nativeInsideOwner(float2 p, device NativeSegment *segments, uint count, long owner, bool previous);

bool nativeForbiddenCenterCrossing(float2 start, float2 end, NativeSegment s,
    device NativeSegment *segments, uint count, device atomic_uint *statistics, bool guardStage) {
    // Guard ma zezwalać na naprawę stanu początkowego w przeszkodzie.
    if (s.flags.z && dot(start - s.previous.xy, nativeSegmentNormal(s.previous)) * s.collision.x < 0) return false;
    if (s.flags.y && nativeInsideOwner(start, segments, count, s.identity.y, true)) return false;
    nativeCountWork(statistics, guardStage ? 6 : 5);
    return nativeCenterCrossing(start, end, s);
}

bool nativeCenterPathFinite(float2 start, float2 end, NativeSegment s, device atomic_uint *statistics) {
    nativeCountWork(statistics, 7);
    float2 e0 = s.previous.zw - s.previous.xy, e1 = s.current.zw - s.current.xy;
    float2 de = e1 - e0, r0 = start - s.previous.xy;
    float2 dr = (end - start) - (s.current.xy - s.previous.xy);
    float a = nativeCross(de, dr), b = nativeCross(e0, dr) + nativeCross(de, r0);
    float c = nativeCross(e0, r0);
    if (a == 0 && b == 0 && c == 0) {
        float q0 = dot(r0, r0 - e0), qa = dot(dr, dr - de);
        float qb = dot(dr, r0 - e0) + dot(r0, dr - de);
        if (!all(isfinite(float4(q0, qa, qb, qa + qb + q0)))) return false;
    }
    return all(isfinite(e0)) && all(isfinite(e1)) && all(isfinite(r0)) && all(isfinite(dr))
        && isfinite(dot(e0, e0)) && isfinite(dot(e1, e1))
        && isfinite(dot(r0, r0)) && isfinite(dot(dr, dr))
        && all(isfinite(float3(a, b, c))) && isfinite(b * b - 4 * a * c);
}

// Tani przesiew ochrony wolnego crossing lub korekcji Jacobi poza maską
// prędkości: bez współczynników kwadratowych, discriminant ani pierwiastków.
bool nativePossibleCenterCrossing(float2 start, float2 end, NativeSegment s) {
    float2 lower = min(start, end), upper = max(start, end);
    float2 segmentLower = min(min(s.previous.xy, s.previous.zw), min(s.current.xy, s.current.zw));
    float2 segmentUpper = max(max(s.previous.xy, s.previous.zw), max(s.current.xy, s.current.zw));
    if (any(lower > segmentUpper) || any(upper < segmentLower)) return false;
    if (all(start == end) && all(s.previous == s.current)) return false;
    float2 previousEdge = s.previous.zw - s.previous.xy, currentEdge = s.current.zw - s.current.xy;
    if (all(previousEdge == currentEdge)) {
        float previousSide = nativeCross(previousEdge, start - s.previous.xy);
        float currentSide = nativeCross(currentEdge, end - s.current.xy);
        if ((previousSide > 0 && currentSide > 0) || (previousSide < 0 && currentSide < 0)) return false;
    }
    return true;
}

kernel void nativeResolveCCD(device NativeBubble *bubbles [[buffer(0)]],
    device NativeSegment *segments [[buffer(1)]], device float4 *positions [[buffer(2)]],
    constant NativeControl &control [[buffer(3)]], device uint *candidates [[buffer(4)]],
    device uint *changed [[buffer(5)]], device atomic_uint *safety [[buffer(6)]],
    device atomic_uint *statistics [[buffer(7)]],
    uint i [[thread_position_in_grid]]) {
    if (i >= control.counts.x) return;
    float2 start = bubbles[i].position.zw, end = positions[i].xy;
    for (uint j = 0; j < control.counts.y; ++j) {
        if (!candidates[i * control.counts.y + j]) continue;
        NativeSegment s = segments[j];
        if (!nativeCenterPathFinite(start, end, s, statistics)) { nativeSafetyFailure(safety, 1); continue; }
        if (!nativeForbiddenCenterCrossing(start, end, s, segments, control.counts.y, statistics, false)) continue;
        float2 corrected = nativeReturnToOriginalSide(start, end, s, bubbles[i].physical.z);
        if (any(corrected != end)) { end = corrected; changed[i] = 1; nativeSafetyEvent(safety, 1); }
    }
    positions[i].xy = end;
}

bool nativeInsideOwner(float2 p, device NativeSegment *segments, uint count, long owner, bool previous) {
    bool inside = false;
    uint edges = 0;
    for (uint j = 0; j < count; ++j) {
        NativeSegment s = segments[j];
        if (!s.flags.y || s.identity.y != owner) continue;
        ++edges;
        float4 endpoints = previous ? s.previous : s.current;
        float2 a = endpoints.xy, b = endpoints.zw;
        if ((a.y > p.y) != (b.y > p.y)) {
            float x = a.x + (b.x - a.x) * (p.y - a.y) / (b.y - a.y);
            if (p.x < x) inside = !inside;
        }
    }
    return edges >= 3 && inside;
}

kernel void nativeApplyCenterGuards(device NativeBubble *bubbles [[buffer(0)]],
    device NativeSegment *segments [[buffer(1)]], device float4 *positions [[buffer(2)]],
    constant NativeControl &control [[buffer(3)]], device NativeContactControl &contacts [[buffer(4)]],
    device uint *changed [[buffer(5)]], device atomic_uint *safety [[buffer(6)]],
    device atomic_uint *statistics [[buffer(7)]],
    device uint *candidates [[buffer(8)]],
    uint i [[thread_position_in_grid]]) {
    if (i >= control.counts.x) return;
    float2 start = bubbles[i].position.zw, end = positions[i].xy;
    float margin = max(contacts.thresholds.z * 2, 1e-5f);
    for (uint j = 0; j < control.counts.y; ++j) {
        NativeSegment s = segments[j];
        float2 corrected = end;
        if (candidates[i * control.counts.y + j] || nativePossibleCenterCrossing(start, end, s)) {
            if (!nativeCenterPathFinite(start, end, s, statistics)) { nativeSafetyFailure(safety, 1); continue; }
            if (nativeForbiddenCenterCrossing(start, end, s, segments, control.counts.y, statistics, true))
                corrected = nativeReturnToOriginalSide(start, end, s, margin);
        }
        if (s.flags.z) {
            float2 normal = nativeSegmentNormal(s.current) * s.collision.x;
            float side = dot(corrected - s.current.xy, normal);
            if (side < 0) corrected += normal * (margin - side);
        }
        if (any(corrected != end)) { end = corrected; changed[i] = 1; nativeSafetyEvent(safety, 1); }
    }
    for (uint j = 0; j < control.counts.y; ++j) {
        NativeSegment s = segments[j];
        if (!s.flags.y) continue;
        bool first = true;
        for (uint k = 0; k < j; ++k)
            if (segments[k].flags.y && segments[k].identity.y == s.identity.y) first = false;
        if (!first || !nativeInsideOwner(end, segments, control.counts.y, s.identity.y, false)) continue;
        float best = INFINITY;
        float2 point = end, outward = float2(1, 0);
        for (uint k = 0; k < control.counts.y; ++k) {
            NativeSegment edge = segments[k];
            if (!edge.flags.y || edge.identity.y != s.identity.y) continue;
            float2 q = nativeClosestPoint(end, edge.current);
            float distance = length(q - end);
            if (distance < best) {
                best = distance; point = q;
                outward = distance > FLT_MIN ? (q - end) / distance : nativeSegmentNormal(edge.current);
            }
        }
        end = point + outward * margin;
        changed[i] = 1; nativeSafetyEvent(safety, 1);
    }
    positions[i].xy = end;
    // Walidacja po WSZYSTKICH korekcjach: ostatnia przeszkoda może zepsuć
    // wcześniejszą. Niespójne ściany/rotacje odrzucają klatkę, bez pętli hosta.
    if (!all(isfinite(end))) nativeSafetyFailure(safety, 1);
    for (uint j = 0; j < control.counts.y; ++j) {
        NativeSegment s = segments[j];
        if (candidates[i * control.counts.y + j] || nativePossibleCenterCrossing(start, end, s)) {
            if (!nativeCenterPathFinite(start, end, s, statistics)) nativeSafetyFailure(safety, 1);
            else if (nativeForbiddenCenterCrossing(start, end, s, segments, control.counts.y, statistics, true))
                nativeSafetyFailure(safety, 2);
        }
        if (s.flags.z && dot(end - s.current.xy, nativeSegmentNormal(s.current)) * s.collision.x < 0)
            nativeSafetyFailure(safety, 2);
        if (s.flags.y && nativeInsideOwner(end, segments, control.counts.y, s.identity.y, false))
            nativeSafetyFailure(safety, 2);
    }
}

uint nativeSafetyBubbleIndex(long id, device NativeBubble *bubbles, uint count) {
    uint lo = 0, hi = count;
    while (lo < hi) { uint mid = lo + (hi - lo) / 2;
        if (bubbles[mid].identity.x < id) lo = mid + 1; else hi = mid; }
    return lo < count && bubbles[lo].identity.x == id ? lo : count;
}

kernel void nativeInvalidateSafetyCache(device NativeBubble *bubbles [[buffer(0)]],
    device NativeContactCache *cache [[buffer(1)]], constant NativeControl &control [[buffer(2)]],
    device NativeContactControl &contacts [[buffer(3)]], device uint *changed [[buffer(4)]],
    device atomic_uint *safety [[buffer(5)]], uint i [[thread_position_in_grid]]) {
    if (contacts.counts.w || i >= contacts.counts.z) return;
    NativeContactCache c = cache[i];
    uint a = nativeSafetyBubbleIndex(c.participants.x, bubbles, control.counts.x);
    uint b = c.metadata.x == 0 ? nativeSafetyBubbleIndex(c.participants.y, bubbles, control.counts.x) : control.counts.x;
    if ((a < control.counts.x && changed[a]) || (b < control.counts.x && changed[b])) {
        c.response.x = 0; c.metadata.y = 1; c.metadata.w |= 8;
        cache[i] = c; nativeSafetyEvent(safety, 2);
    }
}

kernel void nativeCheckFinite(device NativeBubble *bubbles [[buffer(0)]],
    device NativeSegment *segments [[buffer(1)]], device NativeContactCache *cache [[buffer(2)]],
    constant NativeControl &control [[buffer(3)]], device NativeContactControl &contacts [[buffer(4)]],
    device NativeSolverControl &solver [[buffer(5)]], device atomic_uint *safety [[buffer(6)]],
    uint i [[thread_position_in_grid]]) {
    if (i == 0 && !all(isfinite(solver.physics))) nativeSafetyFailure(safety, 1);
    if (i < control.counts.x) {
        NativeBubble b = bubbles[i];
        if (!all(isfinite(b.position)) || !all(isfinite(b.motion)) || !all(isfinite(b.physical))
            || !all(isfinite(b.deformation))) nativeSafetyFailure(safety, 1);
    }
    if (i < control.counts.y) {
        NativeSegment s = segments[i];
        float2 previousEdge = s.previous.zw - s.previous.xy, currentEdge = s.current.zw - s.current.xy;
        if (!all(isfinite(s.previous)) || !all(isfinite(s.current)) || !all(isfinite(s.velocity))
            || !all(isfinite(s.collision)) || !all(isfinite(previousEdge)) || !all(isfinite(currentEdge))
            || !isfinite(dot(previousEdge, previousEdge)) || !isfinite(dot(currentEdge, currentEdge)))
            nativeSafetyFailure(safety, 1);
    }
    if (!contacts.counts.w && i < contacts.counts.z) {
        NativeContactCache c = cache[i];
        if (!all(isfinite(c.geometry)) || !all(isfinite(c.response)) || c.response.x < 0)
            nativeSafetyFailure(safety, 1);
    }
}

struct NativeContourControl { uint4 counts; float4 shape; };

float nativeContourRayLimit(float2 center, float2 direction, float2 a, float2 b,
    float radius, float clearance) {
    float2 edge = b - a, offset = a - center;
    float denominator = nativeCross(direction, edge);
    if (abs(denominator) < 1e-6f) return radius;
    float distance = nativeCross(offset, edge) / denominator;
    float fraction = nativeCross(offset, direction) / denominator;
    return distance >= 0 && fraction >= 0 && fraction <= 1
        ? min(radius, max(0.0f, distance - clearance)) : radius;
}

// Nacisk jest polem radialnym w świecie, a nie sumą skalarnych zgniotów.
// Geometria pochodzi wyłącznie z pozycji zakończonych przez CCD i guardy.
kernel void nativeAccumulateContactPressure(device NativeBubble *bubbles [[buffer(0)]],
    device NativeSegment *segments [[buffer(1)]], device NativeContactCache *cache [[buffer(2)]],
    constant NativeControl &control [[buffer(3)]], device NativeContactControl &contacts [[buffer(4)]],
    constant NativeContourControl &contour [[buffer(5)]], device NativeBubble *previousBubbles [[buffer(6)]],
    device float4 *previousDeformation [[buffer(7)]], device uint *previousCounts [[buffer(8)]],
    device float4 *pressure [[buffer(9)]], device uint *counts [[buffer(10)]],
    device uint4 *adjacency [[buffer(11)]], device uint *degrees [[buffer(12)]],
    device atomic_uint *safety [[buffer(13)]], uint index [[thread_position_in_grid]]) {
    uint bubbleIndex = index / contour.counts.x, sample = index % contour.counts.x;
    if (bubbleIndex >= control.counts.x || contacts.counts.w
        || atomic_load_explicit(safety + 3, memory_order_relaxed)) return;
    NativeBubble bubble = bubbles[bubbleIndex];
    uint count = min(contour.counts.x, max(64u, uint(ceil((bubble.physical.z / contour.shape.x) * (4 * M_PI_F)))));
    if (sample == 0) counts[bubbleIndex] = count;
    if (sample >= count) return;
    float angle = 2 * M_PI_F * float(sample) / float(count);
    float2 direction = float2(cos(angle), sin(angle));
    float limit = bubble.physical.z;
    // Rzeczywiste skończone krawędzie: także te, które guard dopiero dosunął do bańki.
    for (uint j = 0; j < control.counts.y; ++j)
        limit = nativeContourRayLimit(bubble.position.xy, direction, segments[j].current.xy,
            segments[j].current.zw, limit, contour.shape.w);
    float directionalPressure = 0;
    for (uint j = 0; j < degrees[bubbleIndex]; ++j) {
        uint4 edge = adjacency[bubbleIndex * contacts.cache.w + j];
        NativeContactCache contact = cache[edge.x];
        if (contact.metadata.z != contacts.limits.x) continue;
        float2 toward = edge.z == 0 ? bubbles[edge.y].position.xy - bubble.position.xy : -contact.geometry.xy;
        float towardLength = length(toward);
        if (towardLength > FLT_EPSILON) {
            float alignment = max(0.0f, dot(direction, toward / towardLength));
            // Zakończona lambda reprezentuje lokalną kompresję także po rozdzieleniu
            // środków przez twardy PBD. Safety reset zeruje ją przed tym etapem.
            float compression = clamp(contact.response.x * bubble.physical.y / bubble.physical.z,
                0.0f, 0.5f);
            directionalPressure = max(directionalPressure, compression * pow(alignment, 8.0f));
        }
        if (edge.z != 0) continue;
        NativeBubble other = bubbles[edge.y];
        float2 delta = other.position.xy - bubble.position.xy;
        float distance = length(delta);
        float radius = bubble.physical.z, otherRadius = other.physical.z;
        if (distance <= FLT_EPSILON || distance >= radius + otherRadius + contacts.thresholds.z) continue;
        float2 normal = delta / distance;
        // Wspólna skończona cięciwa obu naturalnych kół.
        float planeDistance = clamp((distance * distance + radius * radius - otherRadius * otherRadius)
            / (2 * distance), 0.0f, radius);
        float halfLength = sqrt(max(0.0f, radius * radius - planeDistance * planeDistance));
        float2 tangent = float2(-normal.y, normal.x);
        float2 point = bubble.position.xy + normal * planeDistance;
        limit = nativeContourRayLimit(bubble.position.xy, direction, point - tangent * halfLength,
            point + tangent * halfLength, limit, contour.shape.w);
    }
    float deficit = clamp(1 - limit / bubble.physical.z, 0.0f, 1.0f);
    float recovered = 0;
    uint old = nativeSafetyBubbleIndex(bubble.identity.x, previousBubbles, contour.counts.y);
    if (old < contour.counts.y && previousCounts[old] > 0) {
        // Resampling przy zmianie promienia/liczby punktów zachowuje lokalność nacisku.
        uint oldCount = previousCounts[old];
        float location = float(sample) * float(oldCount) / float(count);
        uint first = uint(location) % oldCount, second = (first + 1) % oldCount;
        recovered = mix(previousDeformation[old * contour.counts.x + first].x,
            previousDeformation[old * contour.counts.x + second].x, fract(location))
            * exp(-contour.shape.y * max(0.0f, bubble.physical.w) * control.physics.x);
    }
    float4 value = float4(max(max(deficit, directionalPressure), recovered), deficit, directionalPressure, 0);
    if (!all(isfinite(value))) nativeSafetyFailure(safety, 1);
    pressure[index] = value;
}

// Jacobi na lokalnych naciskach wygładza przejście, zachowując twardy envelope.
// Kombinacja wypukła nie zwiększa maksimum deformacji i nie wzbudza oscylacji.
kernel void nativeGenerateContours(device float4 *input [[buffer(0)]], device float4 *output [[buffer(1)]],
    device uint *counts [[buffer(2)]], constant NativeControl &control [[buffer(3)]],
    constant NativeContourControl &contour [[buffer(4)]], device atomic_uint *safety [[buffer(5)]],
    uint index [[thread_position_in_grid]]) {
    uint bubbleIndex = index / contour.counts.x, sample = index % contour.counts.x;
    if (bubbleIndex >= control.counts.x || atomic_load_explicit(safety + 3, memory_order_relaxed)) return;
    uint count = counts[bubbleIndex];
    if (sample >= count) return;
    uint base = bubbleIndex * contour.counts.x;
    float4 value = input[index];
    float neighbor = (input[base + (sample + count - 1) % count].x + input[base + (sample + 1) % count].x) * 0.5f;
    float tension = min(0.8f, contour.shape.z / (contour.shape.z + 10));
    value.x = clamp(max(value.y, mix(value.x, neighbor, tension)), 0.0f, 1.0f);
    if (!all(isfinite(value))) nativeSafetyFailure(safety, 1);
    output[index] = value;
}

kernel void nativePrepareRenderData(device NativeBubble *bubbles [[buffer(0)]],
    device float4 *deformation [[buffer(1)]], device uint *counts [[buffer(2)]],
    device float2 *points [[buffer(3)]], device NativeRenderPacket *packets [[buffer(4)]],
    constant NativeControl &control [[buffer(5)]], constant NativeContourControl &contour [[buffer(6)]],
    device atomic_uint *safety [[buffer(7)]], uint index [[thread_position_in_grid]]) {
    if (index >= control.counts.x || atomic_load_explicit(safety + 3, memory_order_relaxed)) return;
    NativeBubble bubble = bubbles[index];
    float maximum = 0;
    for (uint sample = 0; sample < counts[index]; ++sample) {
        uint address = index * contour.counts.x + sample;
        float angle = 2 * M_PI_F * float(sample) / float(counts[index]);
        float2 point = bubble.position.xy + float2(cos(angle), sin(angle))
            * bubble.physical.z * (1 - deformation[address].x);
        if (!all(isfinite(point))) nativeSafetyFailure(safety, 1);
        points[address] = point;
        maximum = max(maximum, deformation[address].x);
    }
    bubble.deformation = float4(maximum, 0, 0, 0);
    bubbles[index] = bubble;
    NativeRenderPacket packet = {bubble.identity,
        float4(bubble.position.xy, bubble.physical.z, bubble.motion.z), bubble.deformation};
    if (!all(isfinite(packet.geometry))) nativeSafetyFailure(safety, 1);
    packets[index] = packet;
}

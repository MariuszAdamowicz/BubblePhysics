#include <metal_stdlib>
using namespace metal;

struct ContourVertexOutput {
    float4 position [[position]];
    float2 worldPosition;
};

struct RenderBubble {
    long2 identity;
    float4 position;
    float4 motion;
    float4 physical;
    float4 deformation;
    uint4 publicFlags;
    float4 material;
    ulong2 resources;
    ulong2 eventData;
};

vertex ContourVertexOutput nativeContourVertex(
    uint vertexID [[vertex_id]], uint bubbleIndex [[instance_id]],
    device const float2 *points [[buffer(0)]], device const uint *counts [[buffer(1)]],
    constant float4 &viewport [[buffer(2)]], constant uint &stride [[buffer(3)]],
    device const RenderBubble *bubbles [[buffer(4)]]) {
    uint count = min(counts[bubbleIndex], stride);
    uint triangle = vertexID / 3;
    uint corner = vertexID % 3;
    uint first = bubbleIndex * stride;
    float2 point = bubbles[bubbleIndex].position.xy;
    if (count > 2 && triangle < count) {
        if (corner == 1) point = points[first + triangle];
        if (corner == 2) point = points[first + ((triangle + 1) % count)];
    }
    float2 clip = (point - viewport.xy) * 2.0 / viewport.zw;
    ContourVertexOutput result;
    result.position = float4(clip.x, clip.y, 0, 1);
    result.worldPosition = point;
    return result;
}

fragment float4 nativeTechnicalFragment(ContourVertexOutput in [[stage_in]]) {
    return float4(0.30, 0.71, 0.85, 1.0);
}

+// PROTOTYP: limit λ pary bańka–bańka, każda strona <= 0,25·r.
+float nativePairLambdaLimit(NativeBubble a, NativeBubble b, float2 normal, float dt) {
+    float approach = (max(0.0f, dot(a.motion.xy, normal)) + max(0.0f, -dot(b.motion.xy, normal))) * dt;
+    float slack = nativeCorrectionLimitFactor * min(a.physical.z, b.physical.z);
+    return (approach + slack) / max(a.physical.y, b.physical.y);
+}
